# Copy to .env (scripts/setup.sh does this for you). Never commit .env.
NODE_ENV=development
# 127.0.0.1 = only this laptop. Change later for home-network access.
HOST=127.0.0.1
PORT=3001
# SQLite file for local development. Relative paths are resolved from backend/prisma/.
# (Docker uses data/piggybank.db for your real data — see docker-compose.yml.)
DATABASE_URL="file:../../data/dev.db"
# Set to true only when the app is served over HTTPS.
COOKIE_SECURE=false
# Set to false after you have created your account.
ALLOW_REGISTRATION=true
# Docker only: the address the app answers on (default 127.0.0.1 = this machine only).
# On a server behind a VPN, its VPN address, e.g. APP_BIND=10.8.0.1
# APP_BIND=127.0.0.1
SESSION_DAYS=30
# Your time zone: decides what "today" is for recurring transactions and snapshots
TZ=Europe/Berlin
# Live exchange rates (only used when a family switches to live rates in Settings)
RATES_URL=https://api.frankfurter.dev/v1
# NSE's public end-of-day price files (only downloaded when a family switches daily prices on)
PRICES_URL=https://nsearchives.nseindia.com/products/content
# Gold for the investments comparison: Indian 22K/24K rates (IBJA) and the world price per ounce
IBJA_URL=https://ibjarates.com/
# NSE corporate-action history (past dividends, splits, mergers)
NSE_HISTORY_URL=https://www.nseindia.com/api/corporates-corporateActions
GOLD_PRICE_URL=https://api.gold-api.com/price/XAU
# The world gold price's history before the daily collection (read once)
GOLD_HISTORY_URL=https://freegoldapi.com/data/latest.json
# Shares outside India and euro markets (onvista), dollars per euro (ECB)
ONVISTA_URL=https://api.onvista.de/api/v1
ECB_URL=https://data-api.ecb.europa.eu/service/data/EXR
# AI suggestions (Claude): a key from console.anthropic.com. Empty = the app never asks an AI.
# Each family also switches "AI suggestions" on in Settings. Only the text of bank lines that
# nothing else could place, their amounts and your category names are sent (account numbers,
# IBANs, emails and phone numbers masked).
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) or the cheaper claude-haiku-5-5
AI_MODEL=claude-opus-5-5
# Tokens a month for the whole server; after that the AI waits for the next month
AI_MONTHLY_TOKENS=2000000
