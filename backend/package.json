{
  "name": "@mypiggybank/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node --env-file=../.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prisma": "dotenv -e ../.env -- prisma",
    "db:migrate": "dotenv -e ../.env -- prisma migrate deploy",
    "postinstall": "prisma generate",
    "seed:demo": "tsx --env-file=../.env src/demo/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.16.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.4.0",
    "prisma": "^6.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dotenv-cli": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
