generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Family {
  id               String             @id @default(uuid())
  name             String
  spendingCurrency String             @default("EUR")
  wealthCurrency   String             @default("INR")
  /// "manual" (only hand-entered rates) or "live" (daily ECB rates; hand-entered ones win)
  rateMode         String             @default("manual")
  /// 50/30/20 bucket targets in whole percent (sum 100)
  targetEssentials Int                @default(50)
  targetFun        Int                @default(30)
  targetFuture     Int                @default(20)
  /// What the family calls its three buckets (shown everywhere instead of the bucket keys)
  nameEssentials   String             @default("Keep Me Alive")
  nameFun          String             @default("Make Me Happy")
  nameFuture       String             @default("Make Me Rich")
  /// Extras that can be switched off in Settings
  quickEntryHints  Boolean            @default(true)
  /// What holdings count with in net worth and goals: "value" (at today's price) or "invested"
  investmentsAt    String             @default("value")
  /// Download daily closing prices from NSE for rupee holdings
  livePrices       Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  users            User[]
  members          FamilyMember[]
  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  exchangeRates    ExchangeRate[]
  categoryLimits   CategoryLimit[]
  assets           Asset[]
  liabilities      Liability[]
  snapshots        NetWorthSnapshot[]
  categoryRules    CategoryRule[]
  recurringRules   RecurringRule[]
  goals            Goal[]
  holdings         Holding[]
  deposits         Deposit[]
  goldItems        GoldItem[]
}

model User {
  id           String        @id @default(uuid())
  familyId     String
  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  email        String        @unique
  passwordHash String
  name         String
  /// owner | member
  role         String        @default("owner")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  member       FamilyMember?

  @@index([familyId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model FamilyMember {
  id             String          @id @default(uuid())
  familyId       String
  family         Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name           String
  userId         String?         @unique
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  accounts       Account[]
  transactions   Transaction[]
  assets         Asset[]
  liabilities    Liability[]
  recurringRules RecurringRule[]
  goals          Goal[]
  holdings       Holding[]
  deposits       Deposit[]
  goldItems      GoldItem[]

  @@unique([familyId, name])
}

model ExchangeRate {
  id         String   @id @default(uuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  month      String
  base       String
  quote      String
  /// 1 base = rateMicros / 1e6 quote
  rateMicros Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([familyId, month, base, quote])
}

/// Public ECB reference rates (not family data): 1 EUR = rateMicros / 1e6 quote, per month.
model LiveRate {
  /// YYYY-MM
  month      String
  quote      String
  rateMicros Int
  /// ECB date of the rate, YYYY-MM-DD
  asOf       String
  /// true once fetched for a finished month (the month-end rate); never fetched again
  final      Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@id([month, quote])
}

model Account {
  id             String          @id @default(uuid())
  familyId       String
  family         Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name           String
  /// current | savings | tagesgeld | cash | credit_card | investment | other
  type           String
  currency       String
  openingBalance BigInt          @default(0)
  ownerMemberId  String?
  owner          FamilyMember?   @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)
  /// liquid | property | investment | other
  assetClass     String          @default("liquid")
  archived       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transactions   Transaction[]   @relation("TransactionAccount")
  transfersIn    Transaction[]   @relation("TransferAccount")
  recurringRules RecurringRule[]
  holdings       Holding[]
  deposits       Deposit[]

  /// a name is unique per person (checked by the app: each member may have their own "Zerodha")
  @@index([familyId])
}

model Category {
  id           String          @id @default(uuid())
  familyId     String
  family       Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name         String
  /// income | expense
  kind         String
  /// essentials | fun | future (expense only)
  bucket       String?
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  transactions Transaction[]
  limits       CategoryLimit[]
  rules        CategoryRule[]
  recurring    RecurringRule[]

  @@unique([familyId, kind, name])
}

model Transaction {
  id                String         @id @default(uuid())
  familyId          String
  family            Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  accountId         String?
  account           Account?       @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  date              DateTime
  /// > 0, minor units of `currency`
  amount            BigInt
  /// ISO code: the account's currency, or the one chosen for a transaction without an account
  currency          String
  /// income | expense | transfer
  type              String
  categoryId        String?
  category          Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  memberId          String?
  member            FamilyMember?  @relation(fields: [memberId], references: [id], onDelete: SetNull)
  merchant          String?
  notes             String?
  /// ",tag1,tag2," lower-case, for LIKE matching
  tags              String         @default("")
  transferAccountId String?
  transferAccount   Account?       @relation("TransferAccount", fields: [transferAccountId], references: [id], onDelete: Cascade)
  transferAmount    BigInt?
  /// one-per-category monthly total entered in the month grid
  isMonthlyTotal    Boolean        @default(false)
  /// "xlsx:YYYY-MM" for rows brought in by the spreadsheet importer
  importBatch       String?
  recurringRuleId   String?
  recurringRule     RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([recurringRuleId, date])
  @@index([familyId, date])
  @@index([accountId, date])
  @@index([familyId, categoryId])
  @@index([familyId, isMonthlyTotal, date])
  @@index([familyId, importBatch])
}

model CategoryLimit {
  id         String   @id @default(uuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  month      String
  /// minor units of `currency`, > 0
  amount     BigInt
  /// the spending currency when the limit was set
  currency   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([familyId, month, categoryId])
}

model Asset {
  id            String           @id @default(uuid())
  familyId      String
  family        Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name          String
  /// liquid | property | investment | other
  assetClass    String
  currency      String
  ownerMemberId String?
  owner         FamilyMember?    @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  valuations    AssetValuation[]

  @@unique([familyId, name])
}

model AssetValuation {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date      DateTime
  value     BigInt
  note      String?
  createdAt DateTime @default(now())

  @@index([assetId, date])
}

model Liability {
  id             String             @id @default(uuid())
  familyId       String
  family         Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name           String
  /// mortgage | car_loan | personal_loan | credit_card | other
  type           String
  currency       String
  ownerMemberId  String?
  owner          FamilyMember?      @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)
  originalAmount BigInt?
  /// annual interest in basis points (3.75 % = 375)
  interestRateBp Int?
  monthlyPayment BigInt?
  startDate      DateTime?
  endDate        DateTime?
  lender         String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  balances       LiabilityBalance[]

  @@unique([familyId, name])
}

model LiabilityBalance {
  id          String    @id @default(uuid())
  liabilityId String
  liability   Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  date        DateTime
  outstanding BigInt
  createdAt   DateTime  @default(now())

  @@index([liabilityId, date])
}

model NetWorthSnapshot {
  id          String   @id @default(uuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  date        DateTime
  currency    String
  assets      BigInt?
  liabilities BigInt?
  netWorth    BigInt
  /// JSON of the computed breakdown at the time; null for manual history entries
  breakdown   String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([familyId, date])
}

model CategoryRule {
  id         String   @id @default(uuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// case-insensitive text matched inside a bank statement line
  pattern    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([familyId, pattern])
}

model RecurringRule {
  id               String        @id @default(uuid())
  familyId         String
  family           Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name             String
  /// income | expense
  type             String
  amount           BigInt
  accountId        String
  account          Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  memberId         String?
  member           FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// weekly | monthly | quarterly | yearly
  frequency        String
  startDate        DateTime
  endDate          DateTime?
  /// occurrences before this date are not generated (the day the rule was created, unless back-filled)
  generateFrom     DateTime
  /// last date already generated; later runs never re-create earlier dates (even if deleted)
  generatedThrough DateTime?
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  transactions     Transaction[]
  /// the recurring deposit whose instalment this rule books
  deposit          Deposit?

  @@index([familyId])
}

/// A savings goal. Progress = linked accounts/assets + manual entries, in the goal currency.
model Goal {
  id           String        @id @default(uuid())
  familyId     String
  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name         String
  /// minor units of `currency`, > 0
  targetAmount BigInt
  currency     String
  targetDate   DateTime?
  memberId     String?
  member       FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  note         String?
  /// active | reached | archived
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  links        GoalLink[]
  entries      GoalEntry[]

  @@index([familyId])
}

/// What a goal counts: an account's balance or an asset's latest value (holdings come later).
model GoalLink {
  id     String @id @default(uuid())
  goalId String
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// account | asset
  kind   String
  refId  String

  @@unique([goalId, kind, refId])
}

/// Money for a goal kept elsewhere (negative = taken out), in the goal currency.
model GoalEntry {
  id        String   @id @default(uuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  date      DateTime
  amount    BigInt
  note      String?
  createdAt DateTime @default(now())

  @@index([goalId])
}

/// A security held by the family (stock, ETF, fund, gold…), valued from trades and prices.
model Holding {
  id             String          @id @default(uuid())
  familyId       String
  family         Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name           String
  /// stock | etf | fund | gold | other
  kind           String
  /// ticker or ISIN
  symbol         String?
  currency       String
  ownerMemberId  String?
  owner          FamilyMember?   @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)
  /// the depot account it sits in (informational)
  accountId      String?
  account        Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  note           String?
  archived       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  trades         HoldingTrade[]
  prices         HoldingPrice[]
  actions        HoldingAction[]
  removedPayouts RemovedPayout[]

  @@index([familyId])
}

/// A dividend or interest payment the person deleted: the daily check never adds it again.
model RemovedPayout {
  holdingId String
  holding   Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  date      DateTime
  /// dividend | interest
  kind      String
  createdAt DateTime @default(now())

  @@id([holdingId, date, kind])
}

model HoldingTrade {
  id        String   @id @default(uuid())
  holdingId String
  holding   Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  date      DateTime
  /// buy | sell | dividend | interest
  type      String
  /// micro-units (1 unit = 1 000 000); 0 for dividends and interest
  units     BigInt
  /// minor units: paid (buy) or received (sell, dividend, interest)
  amount    BigInt
  fees      BigInt   @default(0)
  createdAt DateTime @default(now())

  @@index([holdingId])
}

model HoldingPrice {
  id        String   @id @default(uuid())
  holdingId String
  holding   Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  date      DateTime
  /// micros of the currency per unit (€98.4567 = 98 456 700)
  price     BigInt
  /// manual (typed) | import (holdings file) | nse (downloaded close); NSE never replaces manual
  source    String   @default("manual")
  createdAt DateTime @default(now())

  @@unique([holdingId, date])
}

/// Public facts about an NSE-listed company, from NSE's index lists (refreshed monthly).
model InstrumentInfo {
  symbol    String   @id
  industry  String?
  /// SEBI size group: large | mid | small
  cap       String?
  updatedAt DateTime @updatedAt
}

/// Public market series to compare investments with (Nifty 50, gold), one point per trading day.
model BenchmarkPoint {
  /// nifty50 | gold
  series String
  date   DateTime
  /// closing value in micros (index points, or rupees per unit of the gold ETF)
  value  BigInt

  @@id([series, date])
}

/// Splits, bonus issues and other events from NSE's daily corporate-actions list (bc file).
model CorporateAction {
  symbol  String
  exDate  DateTime
  purpose String
  /// split | bonus | consolidation | review (demerger, rights…: checked by the user) | dividend
  kind    String
  /// units × num / den from the ex-date (null for review)
  num     Int?
  den     Int?
  /// dividends: micros of a rupee per share or unit
  amount  BigInt?
  /// list (NSE's daily list: applied to holdings) | history (looked back on: never applied)
  source  String   @default("list")

  @@id([symbol, exDate, purpose])
}

/// What a corporate action did to a holding: applied (units and earlier prices adjusted) or
/// review (the user checks units and cost). Recorded once per holding and action.
model HoldingAction {
  id          String   @id @default(uuid())
  holdingId   String
  holding     Holding  @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  exDate      DateTime
  purpose     String
  kind        String
  /// applied | review
  status      String
  num         Int?
  den         Int?
  /// micro-units held the day before the ex-date, and after the adjustment
  unitsBefore BigInt
  unitsAfter  BigInt
  createdAt   DateTime @default(now())

  @@unique([holdingId, exDate, purpose])
  @@index([holdingId])
}

/// How far a daily public download has got (e.g. NSE's corporate-actions lists), so a server
/// that was off catches up from there.
model FetchMark {
  name String   @id
  day  DateTime
}

/// A fixed deposit at a bank (recurring deposits later): valued each day from its terms.
model Deposit {
  id              String         @id @default(uuid())
  familyId        String
  family          Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// fd | rd (recurring: `principal` is the monthly instalment; matures `months` after the start)
  kind            String         @default("fd")
  name            String
  currency        String
  ownerMemberId   String?
  owner           FamilyMember?  @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)
  /// the bank account the money came from and is paid back to
  accountId       String?
  account         Account?       @relation(fields: [accountId], references: [id], onDelete: SetNull)
  /// how net worth counts it: liquid | property | investment | other
  assetClass      String         @default("investment")
  /// minor units
  principal       BigInt
  /// yearly rate in basis points (7.25 % = 725)
  rateBp          Int
  startDate       DateTime
  maturityDate    DateTime
  /// monthly | quarterly | half-yearly | yearly
  compounding     String         @default("quarterly")
  /// reinvest (added, paid at maturity) | payout (paid out each period)
  interest        String         @default("reinvest")
  /// paid out and closed: no longer counted
  closedAt        DateTime?
  /// a recurring deposit's monthly instalment, booked from its account by this rule
  recurringRuleId String?        @unique
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([familyId])
}

/// Physical gold (jewellery, coins, bars) in grams: valued each day from the IBJA rate.
model GoldItem {
  id            String        @id @default(uuid())
  familyId      String
  family        Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name          String
  ownerMemberId String?
  owner         FamilyMember? @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)
  /// weight in milligrams (12.345 g = 12345)
  milligrams    Int
  /// 24k | 22k | 18k | 14k
  purity        String
  boughtOn      DateTime?
  /// what was paid (rupees, minor units), if known
  boughtFor     BigInt?
  /// no longer held (sold, given away): not counted from this day
  closedAt      DateTime?
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([familyId])
}

/// A day's closing price of an NSE symbol (public), kept for looking back at corporate actions.
model MarketClose {
  symbol String
  date   DateTime
  /// micros of a rupee per share
  close  BigInt

  @@id([symbol, date])
}

/// A former NSE symbol of a share (TATAMOTORS → TMPV), for prices and history before the rename.
model SymbolAlias {
  symbol String
  former String

  @@id([symbol, former])
}
