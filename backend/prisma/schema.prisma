generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Family {
  id               String             @id @default(uuid())
  name             String
  spendingCurrency String             @default("EUR")
  wealthCurrency   String             @default("INR")
  /// 50/30/20 bucket targets in whole percent (sum 100)
  targetEssentials Int                @default(50)
  targetFun        Int                @default(30)
  targetFuture     Int                @default(20)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  users            User[]
  members          FamilyMember[]
  accounts         Account[]
  categories       Category[]
  transactions     Transaction[]
  exchangeRates    ExchangeRate[]
  categoryLimits   CategoryLimit[]
  assets           Asset[]
  liabilities      Liability[]
  snapshots        NetWorthSnapshot[]
}

model User {
  id           String        @id @default(uuid())
  familyId     String
  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  email        String        @unique
  passwordHash String
  name         String
  /// owner | member
  role         String        @default("owner")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  member       FamilyMember?

  @@index([familyId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model FamilyMember {
  id           String        @id @default(uuid())
  familyId     String
  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name         String
  userId       String?       @unique
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  accounts     Account[]
  transactions Transaction[]
  assets       Asset[]
  liabilities  Liability[]

  @@unique([familyId, name])
}

model ExchangeRate {
  id         String   @id @default(uuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  month      String
  base       String
  quote      String
  /// 1 base = rateMicros / 1e6 quote
  rateMicros Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([familyId, month, base, quote])
}

model Account {
  id             String        @id @default(uuid())
  familyId       String
  family         Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name           String
  /// current | savings | tagesgeld | cash | credit_card | investment | other
  type           String
  currency       String
  openingBalance BigInt        @default(0)
  ownerMemberId  String?
  owner          FamilyMember? @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)
  /// liquid | property | investment | other
  assetClass     String        @default("liquid")
  archived       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  transactions   Transaction[] @relation("TransactionAccount")
  transfersIn    Transaction[] @relation("TransferAccount")

  @@unique([familyId, name])
  @@index([familyId])
}

model Category {
  id           String          @id @default(uuid())
  familyId     String
  family       Family          @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name         String
  /// income | expense
  kind         String
  /// essentials | fun | future (expense only)
  bucket       String?
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  transactions Transaction[]
  limits       CategoryLimit[]

  @@unique([familyId, kind, name])
}

model Transaction {
  id                String        @id @default(uuid())
  familyId          String
  family            Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account       @relation("TransactionAccount", fields: [accountId], references: [id], onDelete: Cascade)
  date              DateTime
  /// > 0, minor units of the account currency
  amount            BigInt
  /// income | expense | transfer
  type              String
  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  memberId          String?
  member            FamilyMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  merchant          String?
  notes             String?
  /// ",tag1,tag2," lower-case, for LIKE matching
  tags              String        @default("")
  transferAccountId String?
  transferAccount   Account?      @relation("TransferAccount", fields: [transferAccountId], references: [id], onDelete: Cascade)
  transferAmount    BigInt?
  /// one-per-category monthly total entered in the month grid
  isMonthlyTotal    Boolean       @default(false)
  /// "xlsx:YYYY-MM" for rows brought in by the spreadsheet importer
  importBatch       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([familyId, date])
  @@index([accountId, date])
  @@index([familyId, categoryId])
  @@index([familyId, isMonthlyTotal, date])
  @@index([familyId, importBatch])
}

model CategoryLimit {
  id         String   @id @default(uuid())
  familyId   String
  family     Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// YYYY-MM
  month      String
  /// spending currency, minor units, > 0
  amount     BigInt
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([familyId, month, categoryId])
}

model Asset {
  id            String           @id @default(uuid())
  familyId      String
  family        Family           @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name          String
  /// liquid | property | investment | other
  assetClass    String
  currency      String
  ownerMemberId String?
  owner         FamilyMember?    @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  valuations    AssetValuation[]

  @@unique([familyId, name])
}

model AssetValuation {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  date      DateTime
  value     BigInt
  note      String?
  createdAt DateTime @default(now())

  @@index([assetId, date])
}

model Liability {
  id             String             @id @default(uuid())
  familyId       String
  family         Family             @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name           String
  /// mortgage | car_loan | personal_loan | credit_card | other
  type           String
  currency       String
  ownerMemberId  String?
  owner          FamilyMember?      @relation(fields: [ownerMemberId], references: [id], onDelete: SetNull)
  originalAmount BigInt?
  /// annual interest in basis points (3.75 % = 375)
  interestRateBp Int?
  monthlyPayment BigInt?
  startDate      DateTime?
  endDate        DateTime?
  lender         String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  balances       LiabilityBalance[]

  @@unique([familyId, name])
}

model LiabilityBalance {
  id          String    @id @default(uuid())
  liabilityId String
  liability   Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  date        DateTime
  outstanding BigInt
  createdAt   DateTime  @default(now())

  @@index([liabilityId, date])
}

model NetWorthSnapshot {
  id          String   @id @default(uuid())
  familyId    String
  family      Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  date        DateTime
  currency    String
  assets      BigInt?
  liabilities BigInt?
  netWorth    BigInt
  /// JSON of the computed breakdown at the time; null for manual history entries
  breakdown   String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([familyId, date])
}
